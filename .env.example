# ---------------------------------------------------------------------------
# LinkedIn Content Copilot - environment configuration
# Copy to .env and fill in. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# ---- App ----
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
LOG_JSON=false

# ---- Database ----
# Default is a local SQLite file under ./data/
# DATABASE_URL=sqlite:////absolute/path/to/copilot.db

# ---- Security ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-a-random-value
PAIRING_CODE_TTL_SECONDS=600
# Must stay false in production; the server refuses to boot with a default key.
ALLOW_INSECURE_SECRET=false

# ---- LLM provider ----
# mock      -> deterministic offline provider (no API key, used by tests)
# anthropic -> Claude API
# openai    -> OpenAI-compatible endpoint
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---- LinkedIn publishing ----
# manual -> copy-ready content + reminder, you post it yourself (safe default)
# api    -> official LinkedIn REST API, requires an authorised member token
# Browser automation is intentionally not supported.
LINKEDIN_PUBLISH_MODE=manual
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
LINKEDIN_API_VERSION=202405

# ---- Jobs ----
JOB_TICK_SECONDS=20
JOB_MAX_ATTEMPTS=5
SCHEDULER_ENABLED=true
